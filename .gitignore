# ============================================================================
# nestjs-weighted-rate-limiter — Git Ignore Configuration
# ============================================================================

# Environment files
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
*.tsbuildinfo

# Testing
coverage/
*.lcov
.nyc_output

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE
.idea/
.vscode/
.vs/
*.swp
*.swo
*.swn
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# VSCode (keep workspace settings if needed, ignore user-specific)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
tmp/
temp/
*.tmp

# Misc
.cache/
.turbo/